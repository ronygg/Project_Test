{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión{% endblock %}
{% block navbar %}
{% endblock %}

{% block body %}

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <div class="container">
        <h5 class="h3 text-center" style="margin-top: 15px">Iniciar sesión</h5>
        <div class="project-form-container">
            <form method="post" action="{{ path('app_login') }}">
                <div class="row justify-content-start align-items-center">
                    <div class="col-md-3">
                        <label class="col-form-label" for="username">Usuario</label>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}"
                               autocomplete="username" required>
                    </div>
                </div>

                <div class="row justify-content-start align-items-center">
                    <div class="col-md-3">
                        <label class="col-form-label" for="password">Contraseña</label>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" type="password" id="password" name="_password"
                               placeholder="Mas de 8 caracteres." required>
                    </div>
                </div>
                {#        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" #}
                {#               value="{{ csrf_token('authenticate') }}"> #}

                <input type="hidden" name="_target_path" value="/gestion">

                <button class="btn btn-lg btn-primary" type="submit">
                    Iniciar
                </button>
            </form>
        </div>
    </div>
{% endblock %}
